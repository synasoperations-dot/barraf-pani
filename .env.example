# Copy to .env.local. NEXT_PUBLIC_* values ship to the browser: never put secrets in them.

# Mock Service Worker answers every /api call (dev / CI). false once the real backend exists.
NEXT_PUBLIC_USE_MOCKS=true
# JazzCash / Easypaisa at checkout (COD only at launch, §13.5). The mocks can test it with true.
NEXT_PUBLIC_ALLOW_ONLINE_PAYMENTS=false
# Canonical site URL (sitemap, OG, JSON-LD, llms.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public). Empty = mock token in mock mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# PostHog project key (public). Empty = analytics only logs to the console.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional Sentry browser reporting (public DSN). Empty = off; the SDK is never loaded.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=

# Server only (never NEXT_PUBLIC_):
# Where Server Component reads go. Default: this server's own origin (the dev mock bridge).
API_BASE_URL=
# Every customer page shows /maintenance (staff apps keep working).
MAINTENANCE_MODE=false
# Low-memory machines: limit static-generation workers during `next build`.
BUILD_CPUS=
